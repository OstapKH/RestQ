<?xml version="1.0" encoding="UTF-8"?>
<!-- Parameter sets must select real data: TPC-H dates span 1992-01 .. 1998-12,
     region/segment values are UPPERCASE, part types end in BRASS/COPPER/STEEL/
     NICKEL/TIN (Q2 matches by suffix), discounts are 0.00-0.10 and Q6 filters
     discount +/- 0.01 with quantity < 24|25. Out-of-range parameters make every
     query return an empty result set - the benchmark then measures the cost of
     finding nothing (the pre-flight validation aborts the run in that case). -->
<parameters>
    <endpoint name="pricing-summary">
        <url>/pricing-summary?delta=60&amp;shipDate=1998-08-01</url>
        <url>/pricing-summary?delta=90&amp;shipDate=1998-06-01</url>
        <url>/pricing-summary?delta=30&amp;shipDate=1998-09-01</url>
        <url>/pricing-summary?delta=120&amp;shipDate=1997-12-01</url>
    </endpoint>

    <endpoint name="supplier-part-info">
        <url>/supplier-part-info?size=15&amp;type=BRASS&amp;region=EUROPE</url>
        <url>/supplier-part-info?size=25&amp;type=STEEL&amp;region=ASIA</url>
        <url>/supplier-part-info?size=10&amp;type=COPPER&amp;region=AMERICA</url>
        <url>/supplier-part-info?size=35&amp;type=NICKEL&amp;region=AFRICA</url>
        <url>/supplier-part-info?size=45&amp;type=TIN&amp;region=EUROPE</url>
    </endpoint>

    <endpoint name="order-revenue-info">
        <url>/order-revenue-info?segment=AUTOMOBILE&amp;date=1995-03-15</url>
        <url>/order-revenue-info?segment=BUILDING&amp;date=1995-03-01</url>
        <url>/order-revenue-info?segment=FURNITURE&amp;date=1995-03-31</url>
        <url>/order-revenue-info?segment=MACHINERY&amp;date=1995-03-10</url>
        <url>/order-revenue-info?segment=HOUSEHOLD&amp;date=1995-03-20</url>
    </endpoint>

    <endpoint name="order-priority-count">
        <url>/order-priority-count?date=1993-07-01</url>
        <url>/order-priority-count?date=1994-01-01</url>
        <url>/order-priority-count?date=1995-04-01</url>
        <url>/order-priority-count?date=1996-07-01</url>
        <url>/order-priority-count?date=1997-01-01</url>
    </endpoint>

    <endpoint name="local-supplier-volume">
        <url>/local-supplier-volume?region=ASIA&amp;startDate=1994-01-01</url>
        <url>/local-supplier-volume?region=EUROPE&amp;startDate=1995-01-01</url>
        <url>/local-supplier-volume?region=AMERICA&amp;startDate=1996-01-01</url>
        <url>/local-supplier-volume?region=AFRICA&amp;startDate=1993-01-01</url>
        <url>/local-supplier-volume?region=ASIA&amp;startDate=1997-01-01</url>
    </endpoint>

    <endpoint name="revenue-increase">
        <url>/revenue-increase?discount=0.06&amp;quantity=24&amp;startDate=1994-01-01</url>
        <url>/revenue-increase?discount=0.05&amp;quantity=25&amp;startDate=1995-01-01</url>
        <url>/revenue-increase?discount=0.07&amp;quantity=24&amp;startDate=1996-01-01</url>
        <url>/revenue-increase?discount=0.08&amp;quantity=25&amp;startDate=1993-01-01</url>
        <url>/revenue-increase?discount=0.04&amp;quantity=24&amp;startDate=1997-01-01</url>
        <url>/revenue-increase?discount=0.09&amp;quantity=25&amp;startDate=1994-01-01</url>
    </endpoint>
</parameters>
